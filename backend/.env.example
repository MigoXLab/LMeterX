# Backend example for standalone / local use.
# Defaults: no LDAP, no OSS, no SLS, no cross-cluster. Copy to .env and fill in.

# Database configuration
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="lmeterx"
DB_PASSWORD="lmeterx_password"
DB_NAME="lmeterx"
DB_POOL_RECYCLE="1800"
# Optional connection-pool tuning (defaults shown):
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

# Logging configuration
LOG_LEVEL="INFO"
DETAIL_LOG_LEVEL="DEBUG"

# JWT configuration (only used when LDAP_ENABLED=true).
# Before enabling LDAP, replace the empty secret with a strong random value.
JWT_SECRET_KEY=""
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
JWT_ISSUER=lmeterx

# Browser authentication cookie settings (only used when LDAP_ENABLED=true).
# Set JWT_COOKIE_SECURE=true when the browser accesses LMeterX over HTTPS.
JWT_COOKIE_NAME=access_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax
JWT_COOKIE_DOMAIN=
JWT_COOKIE_PATH=/

# Browser CORS origins, comma-separated. Replace the LAN placeholder if needed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://<your-lan-ip>:5173

# LDAP is off for standalone. false/off/0 all disable it; true/on/1 enable it.
LDAP_ENABLED=false
# The following are only needed when LDAP_ENABLED=true. Do not leave
# LDAP_PORT empty — an empty value fails integer parsing on startup.
# LDAP_SERVER=ldaps://ldap.example.com
# LDAP_PORT=636
# LDAP_USE_SSL=true
# LDAP_TIMEOUT=5
# LDAP_SEARCH_BASE=OU=Users,DC=example,DC=com
# LDAP_SEARCH_FILTER=(sAMAccountName={username})
# LDAP_USER_DN_TEMPLATE=
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=

# Comma-separated admin usernames. Only used when LDAP_ENABLED=true.
# Empty list means no admins (users can log in but cannot manage others' tasks
# or open system config). Ignored when LDAP is off — everyone is treated as admin.
# Example: ADMIN_USERNAMES=yuanchang,admin
ADMIN_USERNAMES=

# Only checked when LDAP_ENABLED=true. Leave empty for standalone (no auth).
# ENGINE_API_TOKEN authenticates Engine / cluster-agent calls.
# LMETERX_AUTH_TOKEN authenticates Skill / AI Agent calls (whitelist paths only).
ENGINE_API_TOKEN=
LMETERX_AUTH_TOKEN=

# VictoriaMetrics configuration
VICTORIA_METRICS_URL=http://localhost:8428

# Optional Backend scheduler tuning (defaults shown):
# BACKEND_ENQUEUE_INTERVAL=3
# BACKEND_RECONCILE_INTERVAL=30
# ENGINE_HEARTBEAT_STALE_SECONDS=60

# Kubernetes-only pod reconciliation. Keep false for local / docker-compose.
K8S_RECONCILE_ENABLED=false
# Used only when K8S_RECONCILE_ENABLED=true:
# K8S_RECONCILE_INTERVAL=60
# RECONCILE_CLUSTER_ID falls back to CLUSTER_ID if unset.
# RECONCILE_CLUSTER_ID=
# CLUSTER_ID=local
# RECONCILE_NAMESPACE=lmeterx
# RECONCILE_LABEL_SELECTOR=app=lmeterx-engine-1
# ALLOWED_DEPLOYMENTS=   # empty = allow any Engine deployment name

# API connectivity probes: the Backend waits for execution plus result grace.
PROBE_EXECUTION_TIMEOUT=30
PROBE_RESULT_GRACE_SECONDS=15
# Optional explicit override; keep greater than PROBE_EXECUTION_TIMEOUT.
# PROBE_RESULT_TIMEOUT=45

# Aliyun OSS. Off by default; local uploads stay on disk.
# Enable only for multi-cluster dataset transfer and Engine log fallback.
OSS_ENABLED=false
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_URL_EXPIRY=7200

# Alibaba Cloud Simple Log Service. Off by default; logs stay on local disk.
SLS_ENABLED=false
SLS_ENDPOINT=
SLS_PROJECT=
SLS_LOGSTORE=
SLS_ACCESS_KEY_ID=
SLS_ACCESS_KEY_SECRET=
SLS_TOPIC=backend
SLS_SERVICE_NAME=backend
SLS_SOURCE=
SLS_BATCH_SIZE=100
SLS_FLUSH_INTERVAL=2
SLS_QUEUE_SIZE=10000
