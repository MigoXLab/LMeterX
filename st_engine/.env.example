# Engine example for standalone / local use.
# Defaults: API mode against local Backend, no OSS, no SLS, no remote cluster.

# api = poll Backend (default). db = legacy direct MySQL, deprecated.
ENGINE_MODE=api
BACKEND_URL="http://localhost:5001"
# Only required when Backend LDAP_ENABLED=true. Leave empty for standalone.
ENGINE_API_TOKEN=
# Single-instance only: uncomment to use a fixed Engine identity.
# For Docker/Kubernetes replicas, leave unset so each replica gets a unique ID.
# ENGINE_ID="engine-local"
# Scheduling pool shared by all local Engine replicas. This is not multi-cluster.
CLUSTER_ID="local"

LOG_LEVEL="INFO"
DETAIL_LOG_LEVEL="DEBUG"

# Multi-process load generation. LOCUST_CPU_CORES should match the CPU limit.
# With the default threshold, multi-process starts only above 1000 users.
ENABLE_MULTIPROCESS=auto
LOCUST_CPU_CORES=2
MULTIPROCESS_THRESHOLD=1000
MIN_USERS_PER_PROCESS=500
# Optional overrides:
# FORCE_SINGLE_PROCESS=false
# MANAGER_TIMEOUT=30
# FALLBACK_QUEUE_TYPE=gevent

# Engine resource metrics collection interval, in seconds.
RESOURCE_COLLECT_INTERVAL=2

# API-mode polling, heartbeat, and remote log snapshot intervals (seconds).
# Defaults are normally sufficient; uncomment only when tuning is required.
# TASK_POLL_INTERVAL=3
# STOP_POLL_INTERVAL=5
# ENGINE_HEARTBEAT_INTERVAL=10
# LOG_PUSH_INTERVAL=30
# TASK_LOG_PUSH_INTERVAL=10

# API connectivity probes. Backend normally supplies the execution timeout;
# this value is the compatibility fallback for an older Backend.
PROBE_EXECUTION_TIMEOUT=30
PROBE_MAX_WORKERS=4
# Maximum characters retained for one streaming API test preview.
PROBE_MAX_STREAM_RESPONSE_CHARS=1000000

VICTORIA_METRICS_URL="http://localhost:8428"

# Deprecated: DB mode settings (only needed if ENGINE_MODE=db)
# DB_HOST="localhost"
# DB_PORT="3306"
# DB_USER="lmeterx"
# DB_PASSWORD="lmeterx_password"
# DB_NAME="lmeterx"
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE="1800"
# ENGINE_HEARTBEAT_STALE_SECONDS=60
# ENGINE_RECONCILE_INTERVAL=30

# Alibaba Cloud Simple Log Service. Off by default; logs stay on local disk.
SLS_ENABLED=false
SLS_ENDPOINT=
SLS_PROJECT=
SLS_LOGSTORE=
SLS_ACCESS_KEY_ID=
SLS_ACCESS_KEY_SECRET=
SLS_TOPIC=engine
SLS_SERVICE_NAME=engine
SLS_SOURCE=
SLS_BATCH_SIZE=100
SLS_FLUSH_INTERVAL=2
SLS_QUEUE_SIZE=10000

# Aliyun OSS. Off by default; Engine then uses local files / Backend-provided paths.
# Enable together with Backend when remote Engines need dataset download or log upload.
OSS_ENABLED=false
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# Only applies when OSS_ENABLED=true. Ignored while OSS is off.
# Leave empty for auto: task live snapshots off when SLS is on;
# Engine system snapshots stay as OSS fallback/download.
# Set false to disable all live OSS log writes.
OSS_LIVE_LOG_SYNC_ENABLED=
